l><label kind="guard" x="330" y="287">goes(ERC1S, C2S, t)</label><label kind="synchronisation" x="330" y="304">deliver[p]?</label><label kind="assignment" x="330" y="321">move(C2S, -1, 0)</label><label kind="comments" x="330" y="338">recv (12) MAC</label></transition><transition><source ref="C2S"/><target ref="KU"/><label kind="select" x="170" y="230">t : tok_t</label><label kind="guard" x="170" y="247">goes(C2S, KU, t)</label><label kind="synchronisation" x="170" y="264">deliver[p]?</label><label kind="assignment" x="170" y="281">move(KU, -1, 1)</label><label kind="comments" x="170" y="298">recv (13)</label><nail x="150" y="230"/></transition></template><template><name x="5" y="5">Net</name><declaration>// delivers any message that was sent: loss, duplication and reordering are allowed
bool mayDeliver(int p, int e, int k) {
    return (!CHECK_DELIVERY || (TRACE &amp;&amp; k == K_NONE) || sent[1 - p][e][k])
